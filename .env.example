# ===========================================================================
#  AIMIP — root environment for docker compose (copy to .env; never commit .env)
#  Per-service knobs live in backend/.env.example — these are the compose secrets.
# ===========================================================================

# --- Secrets (required) ---
JWT_SECRET=change-me-to-a-long-random-string

# --- Providers (choose adapters; keys only needed for the selected ones) ---
LLM_PROVIDER=mock                 # openai | gemini | mock
EMBEDDING_PROVIDER=sentence_transformer  # openai | gemini | sentence_transformer
MODEL_ARCH=densenet121            # densenet121 | efficientnet_b0
OPENAI_API_KEY=
GEMINI_API_KEY=

# --- Networking / security ---
CORS_ORIGINS=http://localhost
ALLOWED_HOSTS=*                   # comma-separated hostnames in production
