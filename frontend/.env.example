# Frontend environment template (see docs/31_Environment_Configuration.md).
# Base URL of the AIMIP backend API. In dev the Vite proxy also forwards /api.
VITE_API_BASE_URL=http://localhost:8000/api/v1

# Tenant branding shown in the sidebar/topbar. Presentation only — these values
# are never sent to the backend and do not affect auth or data access.
VITE_ORG_NAME=AIMIP Health System
VITE_ORG_UNIT=Radiology · AI Diagnostics
