# Frontend environment template (see docs/31_Environment_Configuration.md).
# Copy to .env.development (local) and set the production value in your host's
# environment UI (Netlify: Site settings -> Environment variables).
#
# Base URL of the AIMIP backend API. MUST end with /api/v1 — every API call is
# made relative to this base. Health and media paths are derived by stripping
# the /api/v1 suffix, so the origin must be correct.
#
#   Development : http://localhost:8000/api/v1   (Vite also proxies /api + /health)
#   Production  : https://<your-backend-host>/api/v1
VITE_API_BASE_URL=http://localhost:8000/api/v1

# Tenant branding shown in the sidebar/topbar. Presentation only — these values
# are never sent to the backend and do not affect auth or data access.
VITE_ORG_NAME=AIMIP Health System
VITE_ORG_UNIT=Radiology · AI Diagnostics
